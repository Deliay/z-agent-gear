# Container image name for admin-web
ADMIN_WEB_IMAGE=

# Container image name for agent-api
AGENT_API_IMAGE=

# Container image name for cloud-controller
CLOUD_CONTROLLER_IMAGE=

# Container image name for controller-api
CONTROLLER_API_IMAGE=

# Parameter cors-origin
CORS_ORIGIN=

