CREDENTIAL_ENCRYPTION_KEY=

# Parameter event-callback-token
EVENT_CALLBACK_TOKEN=

# Parameter frontend-url
FRONTEND_URL=

# Parameter gateway-url
GATEWAY_URL=

# Parameter github-api-base
GITHUB_API_BASE=

# Parameter github-app-id
GITHUB_APP_ID=

# Parameter github-app-private-key
GITHUB_APP_PRIVATE_KEY=

# Parameter github-app-url
GITHUB_APP_URL=

# Parameter github-setup-url
GITHUB_SETUP_URL=

# Parameter github-token-encryption-key
GITHUB_TOKEN_ENCRYPTION_KEY=

# Parameter github-webhook-secret
